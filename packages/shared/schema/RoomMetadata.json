{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "duration_min": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "difficulty": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "voice": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id"
  ]
}
