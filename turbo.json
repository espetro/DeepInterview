{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "1",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["**/*.tsbuildinfo", "node_modules/.cache/tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
